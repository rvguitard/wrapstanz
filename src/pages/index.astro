---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const asset = (name) => `${base}assets/wrapstanz/${name}`;
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? 'https://script.google.com/macros/s/AKfycbyAedkKwDjSHifRVpMrGh0YF6jzSekGHIQhEkOzUT6kXZTljux7HMAMD8RgV40XDyf9Yw/exec';
const siteUrl = 'https://wrapstanz.com/';
const title = 'Wrapstanz | Branded Foldable Phone Stands';
const description = 'Wrapstanz is a foldable, recyclable cardboard phone stand that keeps your brand in view wherever customers watch.';
const socialImage = `${siteUrl}assets/wrapstanz/after.png`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Wrapstanz',
  url: siteUrl,
  logo: `${siteUrl}assets/wrapstanz/logo.png`,
  email: 'hello@wrapstanz.com',
  description,
};
const useCases = [
  { label: 'Airplane', icon: asset('airplane.svg') },
  { label: 'Hotel room', icon: asset('hotel-room.svg') },
  { label: 'Coffee table', icon: asset('coffee-table.svg') },
  { label: 'Work desk', icon: asset('work-desk.svg') },
  { label: 'Gym', icon: asset('gym.svg') },
  { label: 'Vacation', icon: asset('vacation.svg') },
  { label: 'Keynote overflow', icon: asset('keynote.svg') },
  { label: 'Video calls', icon: asset('video-calls.svg') },
];
const scenes = [
  { label: 'Work from anywhere', image: asset('window-seat.png'), featured: true },
  { label: 'The coffee shop office', image: asset('coffee-shop.png') },
  { label: 'Movies, made private', image: asset('picnic.png') },
  { label: 'A screen for two', image: asset('kitchen.png'), featured: true },
  { label: 'Always eye level', image: asset('bathroom.png') },
  { label: 'Keynotes, up close', image: asset('keynote-event.png') },
  { label: 'Video calls', image: asset('video-call.png'), featured: true },
  { label: 'Events after hours', image: asset('bar-event.png') },
  { label: 'Make every view count', image: asset('coloring-airplane.png') },
];
const sceneColumns = [
  [scenes[5], scenes[6]],
  [{ label: 'Events after hours', image: asset('pint.png') }],
  [scenes[2], scenes[7]],
  [scenes[8], scenes[1]],
  [scenes[4], scenes[0]],
  [scenes[3]],
  [
    { label: 'Work from anywhere', image: asset('window-seat-front-1-1.png') },
    { label: 'Work from anywhere', image: asset('window-seat-front-1-2.png') },
  ],
  [{ label: 'Every view, front and center', image: asset('window-seat-front-1-3.png') }],
  [
    { label: 'Always eye level', image: asset('sephora-bathroom-front.png') },
    { label: 'Always eye level', image: asset('sephora-bathroom-front-1.png') },
  ],
  [{ label: 'Work from anywhere', image: asset('window-seat-front-1.png') }],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Wrapstanz" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#5ca3ff" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href={asset('hold-the-phone.svg')} />
    <link rel="alternate icon" type="image/png" href={asset('logo.png')} />
    <link rel="apple-touch-icon" href={asset('logo.png')} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Wrapstanz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1125" />
    <meta property="og:image:height" content="633" />
    <meta property="og:image:alt" content="A branded Wrapstanz foldable phone stand" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Asap:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header shell">
      <a class="brand" href="#top" aria-label="Wrapstanz home">
        <img src={asset('logo.png')} alt="Wrapstanz" />
      </a>
      <button class="contact-link" type="button" data-contact-open>Contact</button>
    </header>

    <dialog class="contact-dialog t-modal" aria-labelledby="contact-title">
      <div class="contact-panel">
        <button class="contact-close" type="button" aria-label="Close contact form" data-contact-close>×</button>
        <div class="contact-content">
          <div class="contact-form-view">
            <h2 id="contact-title">Let ’em “Stan” your brand</h2>
            <form action={contactEndpoint || undefined} method="post" target="contact-submit-frame" data-contact-form data-configured={contactEndpoint ? 'true' : 'false'}>
              <label><span>Name*</span><input name="name" autocomplete="name" required /></label>
              <label><span>Email*</span><input type="email" name="email" autocomplete="email" required /></label>
              <label><span>Company</span><input name="company" autocomplete="organization" /></label>
              <label><span>Questions?</span><textarea name="questions" rows="4"></textarea></label>
              <input type="hidden" name="page" value="Wrapstanz website" />
              <label class="contact-honeypot" aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" /></label>
              <p class="contact-status" aria-live="polite"></p>
              <button type="submit" data-contact-submit>Contact</button>
            </form>
          </div>
          <div class="contact-success" role="status" aria-live="polite">
            <span class="t-success-check" data-state="out" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none">
                <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="3" />
                <path d="M15 24.5 21.5 31 34 17" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <h2>Thanks!<br />We’ll be in touch soon.</h2>
          </div>
        </div>
        <iframe class="contact-submit-frame" name="contact-submit-frame" title="Contact form submission"></iframe>
      </div>
    </dialog>

    <main id="top">
      <section class="hero">
        <div class="shell hero-copy">
          <div class="hero-title-wrap">
            <h1><img src={asset('hold-the-phone.svg')} alt="Hold the phone!" /></h1>
          </div>
          <div class="intro">
            <h2>Wrapstanz puts your brand on top of every view.</h2>
            <div class="hero-description">
              <p>It’s NEW! It’s a foldable, environmentally friendly phone stand, surrounded by your brand.</p>
              <p>There are 50-180 million people that regularly watch video on their phone*. That’s a lot of eyeballs viewing your brand and content. Folks are watching phones on planes, coffee tables, in hotel rooms, on desks, while doing their makeup and more!</p>
              <p>Wrapstanz makes it easy to get their eyes on your brand.</p>
              <small>*Deloitte Research 2026</small>
            </div>
          </div>
        </div>

        <div class="product-stage shell" data-comparison style="--position: 62%">
          <svg class="comparison-outline" aria-hidden="true"><rect /></svg>
          <div class="comparison-layer comparison-before" aria-hidden="true">
            <img src={asset('before.png')} alt="" />
          </div>
          <div class="comparison-layer comparison-after" aria-hidden="true">
            <img src={asset('after.png')} alt="" />
          </div>
          <input class="comparison-range" type="range" min="0" max="100" value="62" aria-label="Before and after comparison slider" />
          <div class="comparison-divider" aria-hidden="true"><span>↔</span></div>
        </div>

        <div class="shell works">
          <strong>It just works – anywhere!</strong>
          <div class="chips">
            {useCases.map((item) => <span><img src={item.icon} alt="" aria-hidden="true" />{item.label}</span>)}
          </div>
        </div>
      </section>

      <section class="brand-section">
        <div class="shell">
          <h2>Get your customers in the fold.<br />Show off your brand with Wrapstanz.</h2>
        </div>
        <div class="scene-track" aria-label="Wrapstanz use cases">
          {[false, true].map((duplicate) => (
            <div class="scene-sequence" aria-hidden={duplicate ? 'true' : undefined}>
              {sceneColumns.map((column) => (
                <div class="scene-column">
                  {column.map((scene) => (
                    <article class="scene-card" tabindex="0">
                      <img src={scene.image} alt="" loading="lazy" />
                      <p>{scene.label}</p>
                    </article>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </div>
        <div class="shell brand-notes">
          <p><strong>Wrap their phone in your brand.</strong> Everything they watch has you talking to them. Create different ones. Make them collectible. Give them a few.</p>
          <p>Your customers are your brand, let them evangelize what a great company you are while they watch.</p>
          <p>They’re happy. You’re happy. Everyone is happy.</p>
          <div class="award"><img src={asset('good-design.png')} alt="Good Design" /> <span>GOOD GREEN DESIGN<br />2026 AWARD ENTRY</span></div>
        </div>
      </section>

      <section class="steps">
        <div class="shell">
          <div class="steps-heading">
            <h2>1, 2, 3…<br />it’s a wrap!</h2>
            <p><strong>Wrapstanz certainly isn’t rocket surgery.</strong>Often the simplest ideas are the best ideas. Fold up some recycled cardboard, put your logo on it, and let your customers enjoy the show… simple.</p>
          </div>
          <div class="step-grid">
            <article>
              <span class="number">1</span>
              <h3>Tear out the window<br />and start to fold.</h3>
              <img class="instruction-art" src={asset('instructions-mobile-1.png')} alt="Tear out the window and start to fold" loading="lazy" />
            </article>
            <article>
              <span class="number">2</span>
              <h3>Unfold the easel<br />back stands.</h3>
              <img class="instruction-art" src={asset('instructions-mobile-2.png')} alt="Unfold the easel back stands" loading="lazy" />
            </article>
            <article>
              <span class="number">3</span>
              <h3>Insert phone<br />and enjoy.</h3>
              <img class="instruction-art" src={asset('instructions-mobile-3.png')} alt="Insert the phone and enjoy" loading="lazy" />
            </article>
          </div>
        </div>
      </section>

      <section class="story-sections shell" aria-label="About Wrapstanz">
        <article class="story-row">
          <div class="story-copy">
            <h2>Who cares?<br />We do.</h2>
            <p>We only use FSC Certified cardboard on all of our products. Using only eco-friendly water-based or soy-based inks helps minimize environmental impact by avoiding harmful chemicals and making the finished project easier to recycle.</p>
            <p>We also donate 1% of all profits to The Nature Conservancy, a dedicated staff, scientists and members advancing effective, lasting conservation in more than 80 countries and territories.</p>
            <div class="impact-marks" aria-label="Sustainability certifications">
              <img src={asset('fsc.png')} alt="FSC certified" />
              <img src={asset('made-in-usa.png')} alt="Made in USA" />
              <img src={asset('nature-conservancy.png')} alt="The Nature Conservancy" />
            </div>
          </div>
          <div class="story-media-frame"><img class="story-media" src={asset('who-cares.png')} alt="A child coloring beside a Wrapstanz display on an airplane tray table" loading="lazy" /></div>
        </article>

        <article class="story-row story-row-reverse">
          <div class="story-copy">
            <h2>Drive them to what you want them to see.<br />That’s the vision.</h2>
            <p>The demo, a keynote or the entire event—a simple printed QR code or URL allows you to direct your viewers to the content you’d like them to see.</p>
            <button class="story-button" type="button" data-contact-open>Get in the fold</button>
          </div>
          <div class="story-media-frame"><img class="story-media" src={asset('drive-them.png')} alt="A purple event-branded Wrapstanz display featuring a QR code" loading="lazy" /></div>
        </article>

        <article class="story-row">
          <div class="story-copy">
            <h2>What do we know?</h2>
            <p>Events are in our blood. We were key leaders in the tech event and startup space, working hundreds of large and small events.</p>
            <p>We had an idea. We know the business of events isn’t just a good time. It’s about customers, prospects, demos, keynotes, leads, results and metrics. We know that giving a customer a useful small gift leads to brand advocacy. And rewarding a prospect leads to awareness, consideration and possibly brand love. Bingo! Wrapstanz was born!</p>
            <p>There is no more room for expensive, destructive technology giveaways that ultimately end up in landfills. If people don’t want them or use them, we’re simply creating more waste. Let’s focus on making something people actually want, will use, and can feel good about: <strong>recycling</strong>.</p>
            <p>This isn’t a premium, this is simple and makes sense. We know it.</p>
          </div>
          <div class="story-media-frame"><img class="story-media" src={asset('who-we-are.png')} alt="A grid of event cards displayed outdoors" loading="lazy" /></div>
        </article>
      </section>

      <section class="price-banner">
        <div class="shell price-grid">
          <img class="price-media" src={asset('best-part.png')} alt="A Wrapstanz display on an airplane tray table" loading="lazy" />
          <div class="price-copy">
            <h2>The best part? The price.<br />They’re made out of<br />cardboard and ink.</h2>
            <button class="price-button" type="button" data-contact-open>Get a quote</button>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>Patent Pending 2026, Poppy &amp; Sons LLC, Wrapstanz ™2026, Inc. All rights reserved. <a class="footer-contact" href="mailto:james@wrapstanz.com">Contact</a></p>
        <a class="brand" href="#top"><img src={asset('logo.png')} alt="Wrapstanz" /></a>
      </div>
    </footer>
    <script>
      document.querySelectorAll<HTMLElement>('[data-comparison]').forEach((comparison) => {
        const range = comparison.querySelector<HTMLInputElement>('.comparison-range');
        if (!range) return;
        let dragging = false;
        const setPosition = (clientX: number) => {
          const bounds = comparison.getBoundingClientRect();
          const value = Math.min(100, Math.max(0, ((clientX - bounds.left) / bounds.width) * 100));
          range.value = String(value);
          comparison.style.setProperty('--position', `${value}%`);
        };
        range.addEventListener('input', () => comparison.style.setProperty('--position', `${range.value}%`));
        range.addEventListener('pointerdown', (event) => {
          dragging = true;
          range.setPointerCapture(event.pointerId);
          setPosition(event.clientX);
        });
        range.addEventListener('pointermove', (event) => { if (dragging) setPosition(event.clientX); });
        range.addEventListener('pointerup', () => { dragging = false; });
        range.addEventListener('pointercancel', () => { dragging = false; });
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLElement>('.scene-track').forEach((track) => {
        if (reduceMotion) return;
        const sequence = track.querySelector<HTMLElement>('.scene-sequence');
        if (!sequence) return;
        let start = performance.now();
        const speed = 42;
        const move = (now: number) => {
          const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
          const cycle = sequence.getBoundingClientRect().width + gap;
          const x = cycle ? ((now - start) / 1000 * speed) % cycle : 0;
          track.style.transform = `translate3d(${-x}px, 0, 0)`;
          requestAnimationFrame(move);
        };
        requestAnimationFrame(move);
      });

      const contactDialog = document.querySelector<HTMLDialogElement>('.contact-dialog');
      const contactPanel = contactDialog?.querySelector<HTMLElement>('.contact-panel');
      const contactOpeners = document.querySelectorAll<HTMLButtonElement>('[data-contact-open]');
      const contactClose = contactDialog?.querySelector<HTMLButtonElement>('[data-contact-close]');
      const contactForm = contactDialog?.querySelector<HTMLFormElement>('[data-contact-form]');
      const contactFrame = contactDialog?.querySelector<HTMLIFrameElement>('.contact-submit-frame');
      const contactStatus = contactDialog?.querySelector<HTMLElement>('.contact-status');
      const contactSubmit = contactDialog?.querySelector<HTMLButtonElement>('[data-contact-submit]');
      const successCheck = contactDialog?.querySelector<HTMLElement>('.t-success-check');
      const successPath = successCheck?.querySelector<SVGPathElement>('svg path');
      const closeMs = Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--modal-close-dur')) || 150;
      let contactPending = false;
      let lastContactOpener: HTMLButtonElement | null = null;

      if (successPath) {
        const length = Math.ceil(successPath.getTotalLength());
        successPath.style.strokeDasharray = String(length);
        successPath.style.strokeDashoffset = String(length);
      }

      function openContact(event: Event) {
        if (!contactDialog || contactDialog.open) return;
        lastContactOpener = event.currentTarget as HTMLButtonElement;
        contactPanel?.setAttribute('data-view', 'form');
        successCheck?.setAttribute('data-state', 'out');
        contactDialog.classList.remove('is-closing');
        contactDialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        requestAnimationFrame(() => contactDialog.classList.add('is-open'));
      }

      function closeContact() {
        if (!contactDialog?.open) return;
        contactDialog.classList.remove('is-open');
        contactDialog.classList.add('is-closing');
        setTimeout(() => {
          contactDialog.classList.remove('is-closing');
          contactDialog.close();
          document.documentElement.style.overflow = '';
          contactPanel?.setAttribute('data-view', 'form');
          successCheck?.setAttribute('data-state', 'out');
          lastContactOpener?.focus();
        }, closeMs);
      }

      contactOpeners.forEach((opener) => opener.addEventListener('click', openContact));
      contactClose?.addEventListener('click', closeContact);
      contactDialog?.addEventListener('cancel', (event) => { event.preventDefault(); closeContact(); });
      contactDialog?.addEventListener('click', (event) => { if (event.target === contactDialog) closeContact(); });
      contactForm?.addEventListener('submit', (event) => {
        if (contactForm.dataset.configured !== 'true') {
          event.preventDefault();
          if (contactStatus) contactStatus.textContent = 'Contact form setup is not complete yet. Please email hello@wrapstanz.com.';
          return;
        }
        contactPending = true;
        if (contactStatus) contactStatus.textContent = 'Sending…';
        if (contactSubmit) contactSubmit.disabled = true;
      });
      contactFrame?.addEventListener('load', () => {
        if (!contactPending) return;
        contactPending = false;
        contactForm?.reset();
        if (contactStatus) contactStatus.textContent = '';
        if (contactSubmit) contactSubmit.disabled = false;
        contactPanel?.setAttribute('data-view', 'success');
        if (successCheck) {
          successCheck.setAttribute('data-state', 'out');
          void successCheck.offsetWidth;
          successCheck.setAttribute('data-state', 'in');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --blue: #648cf0;
    --blue-dark: #173a78;
    --navy: #142e61;
    --orange: #ff951f;
    --cream: #fff5e8;
    --paper: #fffdf8;
    --ink: #172b53;
    --modal-open-dur: 250ms;
    --modal-close-dur: 150ms;
    --modal-scale: 0.96;
    --modal-scale-close: 0.96;
    --modal-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --check-opacity-dur: 500ms;
    --check-rotate-dur: 500ms;
    --check-rotate-from: 80deg;
    --check-bob-dur: 500ms;
    --check-y-amount: 40px;
    --check-blur-dur: 500ms;
    --check-blur-from: 10px;
    --check-path-dur: 500ms;
    --check-path-delay: 80ms;
    --check-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --check-ease-opacity: cubic-bezier(0.22, 1, 0.36, 1);
    --check-ease-rotate: cubic-bezier(0.22, 1, 0.36, 1);
    --check-ease-bob: cubic-bezier(0.34, 1.35, 0.64, 1);
    --check-ease-path: cubic-bezier(0.22, 1, 0.36, 1);
  }

  * { box-sizing: border-box; letter-spacing: 0 !important; }
  html { scroll-behavior: smooth; }
  body { margin: 0; color: var(--ink); background: var(--paper); font-family: 'Asap', sans-serif; }
  a { color: inherit; }
  .shell { width: min(1360px, calc(100% - 40px)); margin-inline: auto; }
  .site-header { position: absolute; z-index: 10; inset: 0 0 auto; height: 84px; display: flex; align-items: center; justify-content: space-between; color: white; }
  .brand { text-decoration: none; font-size: 22px; font-weight: 700; letter-spacing: -1.2px; }
  .brand span { font-style: italic; }
  .brand img { display: block; width: auto; height: 46px; object-fit: contain; }
  .contact-link { border: 2px dashed rgba(255,255,255,.8); padding: 16px 24px; border-radius: 10px; color: inherit; background: transparent; font: inherit; text-decoration: none; font-size: 20px; font-weight: 700; cursor: pointer; transition: color .2s ease, background .2s ease, border-color .2s ease, transform .2s ease, box-shadow .2s ease; }
  .contact-link:hover { color: var(--navy); background: white; border-color: white; transform: translateY(-4px); box-shadow: 0 8px 0 rgba(20,46,97,.18); }

  .t-modal {
    transform-origin: center;
    transform: scale(var(--modal-scale));
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--modal-open-dur) var(--modal-ease),
      opacity   var(--modal-open-dur) var(--modal-ease);
    will-change: transform, opacity;
  }
  .t-modal.is-open {
    transform: scale(1);
    opacity: 1;
    pointer-events: auto;
  }
  .t-modal.is-closing {
    transform: scale(var(--modal-scale-close));
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--modal-close-dur) var(--modal-ease),
      opacity   var(--modal-close-dur) var(--modal-ease);
  }
  .contact-dialog { width: min(680px, calc(100% - 52px)); max-width: none; padding: 0; border: 0; overflow: visible; color: var(--navy); background: transparent; }
  .contact-dialog::backdrop { background: rgba(12, 39, 88, .86); backdrop-filter: blur(4px); }
  .contact-panel { position: relative; padding: 42px 42px 38px; border-radius: 18px; background: #fff8ec; box-shadow: 0 30px 80px rgba(8, 25, 58, .35); }
  .contact-panel::before { content: ''; position: absolute; inset: -18px; border: 4px dashed white; border-radius: 26px; pointer-events: none; }
  .contact-content { display: grid; }
  .contact-form-view, .contact-success { grid-area: 1 / 1; transition: opacity 250ms var(--modal-ease), transform 250ms var(--modal-ease), visibility 250ms; }
  .contact-success { min-height: 440px; display: grid; place-content: center; justify-items: center; gap: 18px; text-align: center; opacity: 0; visibility: hidden; transform: translateY(12px); pointer-events: none; }
  .contact-panel[data-view="success"] .contact-form-view { opacity: 0; visibility: hidden; transform: translateY(-12px); pointer-events: none; }
  .contact-panel[data-view="success"] .contact-success { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; }
  .contact-panel h2 { margin: 0 24px 30px; text-align: center; font-size: clamp(28px, 4vw, 38px); line-height: 1.1; }
  .contact-panel .contact-success h2 { margin: 0; }
  .contact-panel form { display: grid; gap: 12px; }
  .contact-panel label { display: grid; gap: 5px; padding: 13px 18px; border-radius: 10px; background: white; }
  .contact-panel label span { color: #52627d; font-size: 14px; font-weight: 700; }
  .contact-panel input, .contact-panel textarea { width: 100%; padding: 0; border: 0; outline: 0; color: var(--navy); background: transparent; font: inherit; resize: vertical; }
